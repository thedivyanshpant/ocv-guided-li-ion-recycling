&CONTROL
   calculation      = 'vc-relax'
   verbosity        = 'high'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp/'
   prefix           = 'limno2'
   pseudo_dir       = './pseudo/'
/

&SYSTEM
   ibrav            = 0
   nat              = 12
   ntyp             = 3

   ecutwfc          = 60
   ecutrho          = 480

   occupations      = 'fixed'

   nspin            = 2
   starting_magnetization(1) = 0.0
   starting_magnetization(2) = 0.5
   starting_magnetization(3) = 0.0
/

&ELECTRONS
   electron_maxstep = 500
   conv_thr         = 1.0d-8
   mixing_beta      = 0.30
/

&IONS
   ion_dynamics     = 'bfgs'
/

&CELL
   cell_dynamics    = 'bfgs'
/

ATOMIC_SPECIES
Li  6.94      li_pbe_v1.4.uspp.F.UPF
Mn  54.938044 mn_pbe_v1.5.uspp.F.UPF
O   15.999    O.pbe-n-kjpaw_psl.0.1.UPF

