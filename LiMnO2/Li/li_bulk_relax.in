&CONTROL
   calculation      = 'relax'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp/'
   prefix           = 'li_bulk'
   pseudo_dir       = './pseudo/'
/
&SYSTEM
   ecutwfc          = 60
   ecutrho          = 480
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'mv'
   ntyp             = 1
   nat              = 2
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-08
   mixing_beta      = 0.3
/
&IONS
   ion_dynamics     = 'bfgs'
/

ATOMIC_SPECIES
Li 6.94 li_pbe_v1.4.uspp.F.UPF

K_POINTS automatic
20 20 20  0 0 0

CELL_PARAMETERS angstrom
3.43931245000000 0.00000000000000 0.00000000000000
0.00000000000000 3.43931245000000 0.00000000000000
0.00000000000000 0.00000000000000 3.43931245000000

ATOMIC_POSITIONS angstrom
Li 0.0000000000 0.0000000000 0.0000000000  
Li 1.7196562250 1.7196562250 1.7196562250  

