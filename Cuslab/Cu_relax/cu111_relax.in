&CONTROL
    calculation = 'relax',
    prefix = 'cu111_4x4',
    outdir = './tmp/',
    pseudo_dir = './',
    tstress = .true.,
    tprnfor = .true.,
/

&SYSTEM
    ibrav = 0,
    nat = 80,
    ntyp = 1,

    ecutwfc = 60,
    ecutrho = 480,

    occupations = 'smearing',
    smearing = 'mv',
    degauss = 0.02,

    nspin = 1,
/

&ELECTRONS
    conv_thr = 1.0d-8,
    mixing_beta = 0.30,
    electron_maxstep = 500,
/

&IONS
    ion_dynamics = 'bfgs',
/

