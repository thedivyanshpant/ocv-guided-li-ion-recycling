&CONTROL
    calculation = 'relax',
    restart_mode = 'restart',
    prefix = 'cu_pvdf',
    outdir = './tmp/',
    pseudo_dir = './',
    tstress = .true.,
    tprnfor = .true.,
/

&SYSTEM
    ibrav = 0,
    nat = 94,
    ntyp = 4,

    ecutwfc = 60,
    ecutrho = 480,

    occupations = 'smearing',
    smearing = 'mv',
    degauss = 0.02,
/

&ELECTRONS
    conv_thr = 1.0d-8,
    mixing_beta = 0.30,
    electron_maxstep = 300,
/

&IONS
    ion_dynamics = 'bfgs',
/

