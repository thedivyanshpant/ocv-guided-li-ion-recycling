&CONTROL
    calculation='relax',
    prefix='cuo_slab',
    outdir='./tmp/',
    pseudo_dir='./',
    restart_mode='restart',
    tstress=.true.,
    tprnfor=.true.,
/

&SYSTEM
    ibrav=0,
    nat=128,
    ntyp=2,

    ecutwfc=60,
    ecutrho=480,

    occupations='smearing',
    smearing='mv',
    degauss=0.02,

    nspin=2,
    starting_magnetization(1)=0.5,
    starting_magnetization(2)=0.0,
/

&ELECTRONS
    conv_thr=1.0d-8,
    mixing_beta=0.20,
    mixing_mode='local-TF',
    electron_maxstep=600,
/

&IONS
    ion_dynamics='bfgs',
/

