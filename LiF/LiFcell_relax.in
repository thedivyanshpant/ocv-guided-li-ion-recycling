&CONTROL
 calculation = 'relax'
 prefix = 'LiFcell'
 pseudo_dir = './pseudo/'
 outdir = './tmp/LiFcell/'
 restart_mode = 'from_scratch'
 tprnfor = .true.
 tstress = .true.
/

&SYSTEM
 ibrav = 0,
 nat = 128,
 ntyp = 2,
 ecutwfc = 60,
 ecutrho = 480,
 occupations = 'fixed'
  nosym = .true.
/

&ELECTRONS
 conv_thr = 1.0d-8,
 mixing_beta = 0.30,
 electron_maxstep = 400,
/

&IONS
 ion_dynamics = 'bfgs'
/

