&CONTROL
    calculation = 'scf',
    prefix = 'pvdf_dimer',
    outdir = './tmp/',
    pseudo_dir = './',
/

&SYSTEM
    ibrav = 0,
    nat = 14,
    ntyp = 3,

    ecutwfc = 60,
    ecutrho = 480,

    occupations = 'smearing',
    smearing = 'mv',
    degauss = 0.02,
/

&ELECTRONS
    conv_thr = 1.0d-8,
    mixing_beta = 0.30,
    startingpot = 'atomic',
    startingwfc = 'atomic+random',
/

ATOMIC_SPECIES
C  12.011  C.upf
H   1.008  H.upf
F  18.998  F.upf


